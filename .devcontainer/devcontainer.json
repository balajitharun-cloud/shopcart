{
  "name": "ShopCart (Java 17 + Maven)",
  "image": "mcr.microsoft.com/devcontainers/java:17",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": true
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "ShopCart API + storefront",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "mvn -B -q -DskipTests dependency:go-offline",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-boot-dev-pack"]
    }
  }
}
